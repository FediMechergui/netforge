{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@netforge/engine": ["../../packages/engine/src/index.ts"],
      "@netforge/engine/pure": ["../../packages/engine/src/pure.ts"],
      "@netforge/engine/contracts": ["../../packages/engine/src/contracts/index.ts"],
      "@netforge/engine/curriculum": ["../../packages/engine/src/curriculum-entry.ts"],
      "@netforge/engine/web": ["../../packages/engine/src/web.ts"],
      "@/*": ["./src/*"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
